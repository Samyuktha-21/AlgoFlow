rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Live hero counters ─────────────────────────────────────
    // One shared doc, readable by everyone. Writes are restricted to
    // the whitelisted counter fields AND each touched counter may only
    // move up by exactly 1 per write — no resets, no giant fake jumps.
    match /stats/site {
      function siteKeysOk() {
        return request.resource.data.keys().hasOnly([
          'visits', 'logins', 'algoViews', 'learners',
          'vizRuns', 'learningMinutes', 'interviewViews', 'updatedAt'
        ]);
      }
      function isOne(f) {
        return !(f in request.resource.data) || request.resource.data[f] == 1;
      }
      function bumpsBy1(f) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f])
          || request.resource.data[f] == resource.data.get(f, 0) + 1;
      }
      allow read: if true;
      allow create: if siteKeysOk()
        && isOne('visits') && isOne('logins') && isOne('algoViews')
        && isOne('learners') && isOne('vizRuns') && isOne('learningMinutes')
        && isOne('interviewViews');
      allow update: if siteKeysOk()
        && bumpsBy1('visits') && bumpsBy1('logins') && bumpsBy1('algoViews')
        && bumpsBy1('learners') && bumpsBy1('vizRuns') && bumpsBy1('learningMinutes')
        && bumpsBy1('interviewViews');
    }

    // ── Per-algorithm view counters ────────────────────────────
    // One doc per algorithm: algoStats/{categoryId}__{algorithmId}.
    // Same protection: views may only ever increase by 1, and the
    // id fields must match the document's own id.
    match /algoStats/{algoId} {
      function algoKeysOk() {
        return request.resource.data.keys().hasOnly([
          'views', 'categoryId', 'algorithmId', 'updatedAt'
        ])
        && algoId == request.resource.data.categoryId + '__' + request.resource.data.algorithmId;
      }
      allow read: if true;
      allow create: if algoKeysOk() && request.resource.data.views == 1;
      allow update: if algoKeysOk()
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // ── User profiles + progress ───────────────────────────────
    // Only the owner reads their own doc (holds email). The client may write
    // ONLY profile + learned/bookmarks; every XP-bearing field (solved,
    // solvedCount, dailyCount, streaks, quizXp*, xp, …) is writable solely by
    // the Cloud Functions Admin SDK (which bypasses rules), so XP cannot be
    // forged from the browser. Keep this whitelist in sync with the client
    // writers (AuthContext profile write + ProgressContext learned/bookmarks).
    match /users/{userId} {
      function ownsDoc() { return request.auth != null && request.auth.uid == userId; }
      function clientKeys() {
        return [
          'uid', 'name', 'email', 'avatar', 'joinedAt', 'lastSeen',
          'postsCount', 'commentsCount', 'role',
          'learned', 'bookmarks'
        ];
      }
      allow read:   if ownsDoc();
      allow create: if ownsDoc() && request.resource.data.keys().hasOnly(clientKeys());
      allow update: if ownsDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientKeys());
      allow delete: if false;
    }

    // ── Verified leaderboard ───────────────────────────────────
    // Public board of daily-challenge performance. Read-only to
    // everyone; the ONLY writer is the recordDailyCompletion Cloud
    // Function (Admin SDK, bypasses rules), so `score` cannot be
    // forged from the client — no client write path exists.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Discussion board ───────────────────────────────────────
    // Owners may edit their post; anyone signed in may only touch
    // the like/reply-count fields.
    match /discussions/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likedBy', 'replyCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy']);
        // Reply author may delete; the post owner may also clean up
        // all replies when deleting their post.
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          request.auth.uid == get(/databases/$(database)/documents/discussions/$(postId)).data.uid
        );
      }
    }

    // ── Exit-intent feedback ───────────────────────────────────
    // Anyone may submit a review; write-only (no public reads) and
    // strictly shaped so the collection can't be abused as storage.
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'rating', 'foundIt', 'satisfied', 'comment', 'page', 'createdAt'
        ])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.foundIt is bool
        && request.resource.data.satisfied is bool
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── Per-algorithm comments (subcollection) ─────────────────
    // algorithmComments/{algoId}/comments/{commentId}
    match /algorithmComments/{algoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likedBy']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
  }
}
